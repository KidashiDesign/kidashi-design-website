---
export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  navVariant?: '' | 'nav--light' | 'nav--dark';
  navActive?: 'home' | 'services' | 'about' | 'portfolio' | 'gallery' | 'contact' | '';
  extraStylesheets?: string[];
  jsonLd?: string;
  extraHeadScripts?: string[];
  extraBodyScripts?: string[];
  headStyle?: string;
}

const {
  title,
  description,
  ogImage = 'https://www.kidashidesign.com/images/vorschaubild-link-kidashi-design.png',
  canonical,
  navVariant = '',
  navActive = '',
  extraStylesheets = [],
  jsonLd,
  extraHeadScripts = [],
  extraBodyScripts = [],
  headStyle,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();

const navLink = (key: string) => (navActive === key ? 'nav__link active' : 'nav__link');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preload" href="/fonts/MangoGrotesque-Bold.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/MangoGrotesque-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
  {extraStylesheets.map((href) => <link rel="stylesheet" href={href} />)}
  <script src="/js/main.js" defer></script>
  {extraHeadScripts.map((src) => <script src={src} defer></script>)}
  {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  {headStyle && <style set:html={headStyle} />}
</head>
<body>

<div class="cursor" aria-hidden="true"></div>

<!-- NAV -->
<nav class={`nav ${navVariant}`.trim()}>
  <div class="nav__inner">
    <div class="nav__dock">
      <a href="/" class="nav__logo">
    <img src="/images/logo.svg" class="logo" alt="Kidashi Design Logo" width="220" height="40" />
    </a>
    <ul class="nav__links">
      <li><a href="/" class={navLink('home')}>Home</a></li>
      <li><a href="/services/" class={navLink('services')}>Services</a></li>
      <li><a href="/about/" class={navLink('about')}>About</a></li>
      <li><a href="/portfolio/" class={navLink('portfolio')}>Portfolio</a></li>
      <li><a href="/gallery/" class={navLink('gallery')}>Gallery</a></li>
      <li><a href="/contact/" class={navLink('contact')}>Contact</a></li>
    </ul>
    <div class="nav__location"><span class="nav__location-time" id="navTime"></span><span class="nav__location-sep">·</span><span class="nav__location-city">Tbilisi</span><span class="nav__location-tz">GMT+4</span></div>
    </div>
    <button class="nav__burger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>
<div class="nav__mobile">
  <div class="nav__mobile-inner">
    <div class="nav__mobile-top">
      <nav class="nav__mobile-links">
      <a href="/" class="nav__link">Home</a>
      <a href="/services/" class="nav__link">Services</a>
      <a href="/about/" class="nav__link">About</a>
      <a href="/portfolio/" class="nav__link">Portfolio</a>
      <a href="/gallery/" class="nav__link">Gallery</a>
      <a href="/contact/" class="nav__link">Contact</a>
      </nav>
      <button class="nav__mobile-close" aria-label="Close menu">Close</button>
    </div>
    <div class="nav__mobile-meta">
      <span class="nav__mobile-meta-date" id="mobileDate"></span>
      <span class="nav__mobile-meta-time" id="mobileTime"></span>
      <span class="nav__mobile-meta-tz">GMT +4</span>
    </div>
  </div>
</div>

<slot />

{extraBodyScripts.map((src) => <script src={src} defer></script>)}
</body>
</html>
