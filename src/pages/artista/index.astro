---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title={"Artista Magazin — Self-Published Art Magazine Design | Kidashi Design"}
  description={"Self-published art magazine covering watercolour, charcoal, ceramics, photography and origami — full editorial design and layout by Kidashi Design."}
  canonical={"https://www.kidashidesign.com/portfolio/artista-magazin/"}
  navActive={"portfolio"}
>
<!-- HERO -->
<section class="proj-hero">
  <div class="proj-hero__bg">
    <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0.18;">
      <span style="font-family:var(--font-b);font-size:0.7rem;letter-spacing:0.3em;text-transform:uppercase;color:var(--cream);">Visual Coming Soon</span>
    </div>
  </div>
  <div class="proj-hero__eyebrow">
    <a href="https://www.kidashidesign.com/portfolio/" class="proj-hero__back">← Portfolio</a>
    <span class="proj-hero__category">Print</span>
  </div>
  <div class="proj-hero__content">
    <h1 class="proj-hero__title">Artista Magazin</h1>
    <div class="proj-hero__strip">
      <div class="proj-hero__meta">
        <span class="proj-meta__label">Category</span>
        <span class="proj-meta__value">Print · Editorial Design</span>
      </div>
      <div class="proj-hero__meta">
        <span class="proj-meta__label">Year</span>
        <span class="proj-meta__value">2021</span>
      </div>
      <div class="proj-hero__meta">
        <span class="proj-meta__label">Client</span>
        <span class="proj-meta__value">Self-Initiated</span>
      </div>
      <div class="proj-hero__meta">
        <span class="proj-meta__label">Services</span>
        <span class="proj-meta__value">Editorial Design, Layout, Print</span>
      </div>
    </div>
  </div>
</section>
<div class="proj-services">
  <span class="proj-services__pill">Magazine Design</span>
  <span class="proj-services__pill">Print</span>
</div>

<!-- STATEMENT -->
<section class="proj-statement">
  <p class="proj-statement__text reveal">A personal art magazine that became a design statement.</p>
  <p class="proj-statement__desc reveal" data-delay="100">Self-published art magazine celebrating watercolour, charcoal, ceramics, photography and origami. Conceived, designed and produced entirely independently — from editorial concept to print-ready files.</p>
</section>

<!-- QUOTE -->
<section class="proj-quote">
  <blockquote>
    <p class="proj-quote__text reveal">&#8220;The best editorial design gets out of the art's way.&#8221;</p>
    <footer class="proj-quote__attr reveal" data-delay="100">— Nicole Szatkowski, Kidashi Design</footer>
  </blockquote>
</section>

<!-- PROCESS -->
<section class="proj-process">
  <div class="proj-process__header">
    <h2 class="proj-process__heading reveal">Process &amp; Approach</h2>
    <span class="proj-process__count">3 Steps</span>
  </div>
  <div class="proj-process__step reveal" data-delay="0">
    <span class="proj-process__num">01</span>
    <h3 class="proj-process__step-title">Concept & Curation</h3>
    <p class="proj-process__step-body">Defined the editorial concept and selected works across five distinct art disciplines for visual cohesion.</p>
  </div>
  <div class="proj-process__step reveal" data-delay="100">
    <span class="proj-process__num">02</span>
    <h3 class="proj-process__step-title">Layout Design</h3>
    <p class="proj-process__step-body">Grid-based layout with intentional rhythm — each chapter opening establishing a distinct visual mood.</p>
  </div>
  <div class="proj-process__step reveal" data-delay="200">
    <span class="proj-process__num">03</span>
    <h3 class="proj-process__step-title">Print Production</h3>
    <p class="proj-process__step-body">Magazine prepared to print production standards — paper specifications, colour profiles and press-ready PDF delivery.</p>
  </div>
</section>

<!-- NEXT PROJECT -->
<a href="https://www.kidashidesign.com/portfolio/piano-post/" class="proj-next" aria-label="Next project: Piano Post">
  <div class="proj-next__content">
    <span class="proj-next__label">Next Project</span>
    <p class="proj-next__title">Piano Post</p>
    <span class="proj-next__link">View Project</span>
  </div>
</a>

<footer class="footer">
  <div class="container">
    <div class="footer__inner">
      <div class="footer__brand">
        <a href="https://www.kidashidesign.com/" class="nav__logo"><span class="nav__logo-k" data-text="Kidashi">Kidashi</span><span class="nav__logo-d">Design</span></a>
        <p class="footer__tagline">Certified Graphic Designer — Working Worldwide</p>
      </div>
      <nav class="footer__nav">
        <a href="https://www.kidashidesign.com/">Home</a>
        <a href="https://www.kidashidesign.com/services/">Services</a>
        <a href="https://www.kidashidesign.com/about/">About</a>
        <a href="https://www.kidashidesign.com/portfolio/">Portfolio</a>
        <a href="https://www.kidashidesign.com/gallery/">Gallery</a>
        <a href="https://www.kidashidesign.com/contact/">Contact</a>
        <a href="https://www.kidashidesign.com/impressum/">Legal Notice</a>
        <a href="https://www.kidashidesign.com/datenschutz/">Privacy Policy</a>
      </nav>
    </div>
    <div class="footer__bottom">
      <span class="footer__copy">© 2026 Kidashi Design — Nicole Szatkowski</span>
      <div class="footer__social">
        <a href="https://www.kidashidesign.com/impressum/">Legal Notice</a>
        <a href="https://www.kidashidesign.com/datenschutz/">Privacy Policy</a>
        <a href="https://linktr.ee/kidashi.design" target="_blank" rel="noopener">linktr.ee/kidashi.design</a>
      </div>
    </div>
  </div>
</footer>
</Layout>
