---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Strategic Brand Identity & Visual System Design | Kidashi Design";
const pageDescription = "Comprehensive brand identity design including primary & secondary logos, typography systems, color palettes, and complete brand guidelines. Designed by Nicole Szatkowski.";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://www.kidashidesign.com/services/brand-identity#service",
      "name": "Brand Identity System Design",
      "provider": {
        "@type": "ProfessionalService",
        "name": "Kidashi Design",
        "url": "https://www.kidashidesign.com/",
        "founder": "Nicole Szatkowski"
      },
      "description": "End-to-end brand identity design, logo creation, typography hierarchies, brand color palettes, and brand style guides for digital and physical touchpoints.",
      "areaServed": "Worldwide"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is included in a complete brand identity package from Kidashi Design?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A full brand identity system includes primary, secondary, and sub-mark logo files (vector SVG, EPS, PNG), brand color palettes (HEX, RGB, CMYK, Pantone), custom typography pairings, visual asset usage rules, and a digital Brand Book PDF."
          }
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="max-w-6xl mx-auto px-6 py-16 text-gray-100">
    <nav class="text-sm mb-8 text-gray-400">
      <a href="/" class="hover:text-white transition-colors">Home</a> &rarr; 
      <a href="/services" class="hover:text-white transition-colors">Services</a> &rarr; 
      <span class="text-white font-medium">Brand Identity</span>
    </nav>

    <header class="mb-16 border-b border-gray-800 pb-12">
      <span class="text-xs uppercase tracking-widest text-indigo-400 font-semibold">Service 02 &bull; Visual Systems</span>
      <h1 class="text-4xl md:text-6xl font-bold mt-4 mb-6 leading-tight text-white">
        Cohesive Brand Identities Engineered for Lasting Recognition
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl leading-relaxed">
        We craft cohesive, scalable visual systems that resonate across web, social media, and physical media. Led by <strong class="text-white">Nicole Szatkowski</strong>, IHK-Certified Media Designer blending German technical discipline with international creative perspective.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="https://www.kidashidesign.com/#contact" class="bg-white text-black px-6 py-3 font-medium hover:bg-gray-200 transition-colors">Request a Brand Consultation</a>
        <a href="https://www.kidashidesign.com/#portfolio" class="border border-gray-700 px-6 py-3 font-medium hover:border-gray-500 transition-colors">Explore Brand Case Studies</a>
      </div>
    </header>

    <!-- Deliverables Summary Table -->
    <section class="mb-16 bg-gray-900/60 border border-gray-800 p-8 rounded-lg">
      <h2 class="text-2xl font-semibold mb-6 text-white">Brand Identity Package Deliverables</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm border-collapse">
          <thead>
            <tr class="border-b border-gray-800 text-gray-400">
              <th class="py-3 px-4 uppercase font-medium">Deliverable Category</th>
              <th class="py-3 px-4 uppercase font-medium">Included Assets</th>
              <th class="py-3 px-4 uppercase font-medium">Formats & Standards</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-800 text-gray-300">
            <tr>
              <td class="py-4 px-4 font-semibold text-white">Logo Suite</td>
              <td class="py-4 px-4">Primary mark, horizontal layout, favicon/icon badge, monochrome variants</td>
              <td class="py-4 px-4">Vector (SVG, EPS, AI), Web (PNG, WebP)</td>
            </tr>
            <tr>
              <td class="py-4 px-4 font-semibold text-white">Color Architecture</td>
              <td class="py-4 px-4">Primary, secondary, and functional accent colors + contrast ratios</td>
              <td class="py-4 px-4">HEX, RGB, CMYK, Pantone (PMS)</td>
            </tr>
            <tr>
              <td class="py-4 px-4 font-semibold text-white">Typography System</td>
              <td class="py-4 px-4">Primary heading, body copy, and UI font pairing guidelines</td>
              <td class="py-4 px-4">WOFF2 (Web), OTF/TTF (Desktop)</td>
            </tr>
            <tr>
              <td class="py-4 px-4 font-semibold text-white">Brand Guidelines Book</td>
              <td class="py-4 px-4">Usage rules, minimum sizes, clear space, background rules, photography style</td>
              <td class="py-4 px-4">PDF Document + Digital Figma System</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Pillars of Kidashi Brand Systems -->
    <section class="mb-20">
      <h2 class="text-3xl font-bold mb-10 text-white">Core Pillars of Our Branding Strategy</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 border border-gray-800 bg-gray-950">
          <h3 class="text-xl font-bold mb-3 text-white">Versatility Across Mediums</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Your brand identity will render crisply whether scaled down to an app icon or printed on a large-format trade show banner using CMYK spot colors.
          </p>
        </div>
        <div class="p-6 border border-gray-800 bg-gray-950">
          <h3 class="text-xl font-bold mb-3 text-white">German Certified Precision</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            IHK certification guarantees strict adherence to grid layouts, typographic kerning, color contrast compliance, and file organization.
          </p>
        </div>
        <div class="p-6 border border-gray-800 bg-gray-950">
          <h3 class="text-xl font-bold mb-3 text-white">Future-Proofed Asset Suites</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            We provide structured vector assets and Figma design tokens, making it effortless for your internal team or developers to build new branded pages.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-8 text-white">Brand Identity FAQs</h2>
      <div class="space-y-6">
        <div class="p-6 border border-gray-800 rounded-lg">
          <h3 class="text-lg font-semibold text-white mb-2">What is the difference between a logo design and a complete brand identity?</h3>
          <p class="text-gray-400 text-sm leading-relaxed">A logo is a single mark. A brand identity is an interconnected visual system comprising logos, typography rules, color palettes, photographic guidelines, and asset systems that maintain visual consistency across all touchpoints.</p>
        </div>
        <div class="p-6 border border-gray-800 rounded-lg">
          <h3 class="text-lg font-semibold text-white mb-2">Can you refresh an existing brand without starting from scratch?</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Yes. We offer brand evolution services that modernize your existing visual mark and establish clean, updated typography and digital guidelines while preserving your established brand recognition.</p>
        </div>
      </div>
    </section>

    <section class="p-10 border border-gray-800 bg-gradient-to-r from-gray-950 via-gray-900 to-gray-950 text-center rounded-lg">
      <h2 class="text-3xl font-bold text-white mb-4">Elevate Your Visual Identity</h2>
      <p class="text-gray-400 max-w-2xl mx-auto mb-8">Let's build a distinctive brand identity that elevates your positioning in international markets.</p>
      <a href="https://www.kidashidesign.com/#contact" class="inline-block bg-white text-black px-8 py-4 font-semibold hover:bg-gray-200 transition-colors">Start Your Branding Project</a>
    </section>
  </main>
</Layout>