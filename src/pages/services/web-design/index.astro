---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Custom Web Design & Jamstack Development Services | Kidashi Design";
const pageDescription = "High-performance, mobile-first, and GEO-optimized websites custom built with Astro and Tailwind CSS. Designed by Nicole Szatkowski, IHK-certified Media Designer.";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://www.kidashidesign.com/services/web-design#service",
      "name": "Custom Web Design & Astro Development",
      "provider": {
        "@type": "ProfessionalService",
        "name": "Kidashi Design",
        "url": "https://www.kidashidesign.com/",
        "founder": "Nicole Szatkowski",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Tbilisi",
          "addressCountry": "Georgia"
        }
      },
      "description": "Custom high-performance web design, UI/UX prototyping in Figma, and lightweight, SEO-friendly Astro.js development optimized for AI search engines.",
      "areaServed": "Worldwide",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Web Design Deliverables",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom UI/UX Design (Figma)" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Astro.js & Tailwind CSS Development" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "GEO & Core Web Vitals Optimization" } }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Why build custom websites with Astro.js instead of WordPress?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Astro delivers near-zero JavaScript by default, resulting in sub-second load times, 100/100 Core Web Vitals scores, better Google rankings, and enhanced crawlability for AI engines like Perplexity and ChatGPT."
          }
        },
        {
          "@type": "Question",
          "name": "What is included in Kidashi Design's web design service?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Services include full UI/UX design in Figma, responsive frontend development using Astro and Tailwind CSS, mobile optimization, GEO/SEO metadata setup, JSON-LD schema integration, and pre-launch QA."
          }
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="max-w-6xl mx-auto px-6 py-16 text-gray-100">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-8 text-gray-400">
      <a href="/" class="hover:text-white transition-colors">Home</a> &rarr; 
      <a href="/services" class="hover:text-white transition-colors">Services</a> &rarr; 
      <span class="text-white font-medium">Web Design</span>
    </nav>

    <!-- Hero Section -->
    <header class="mb-16 border-b border-gray-800 pb-12">
      <span class="text-xs uppercase tracking-widest text-emerald-400 font-semibold">Service 01 &bull; Digital & Code</span>
      <h1 class="text-4xl md:text-6xl font-bold mt-4 mb-6 leading-tight text-white">
        High-Performance Web Design Built to Convert & Rank in AI Search
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl leading-relaxed">
        Custom, mobile-first web design powered by modern Jamstack architecture (<strong class="text-white">Astro.js</strong> and <strong class="text-white">Tailwind CSS</strong>). Designed by <strong class="text-white">Nicole Szatkowski</strong>—IHK-Certified Media Designer based in Tbilisi, Georgia, crafting digital experiences for clients worldwide.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="https://www.kidashidesign.com/#contact" class="bg-white text-black px-6 py-3 font-medium hover:bg-gray-200 transition-colors">Start a Web Project</a>
        <a href="https://www.kidashidesign.com/#portfolio" class="border border-gray-700 px-6 py-3 font-medium hover:border-gray-500 transition-colors">View Selected Work</a>
      </div>
    </header>

    <!-- At a Glance Specifications (GEO / AI Context) -->
    <section class="mb-16 bg-gray-900/60 border border-gray-800 p-8 rounded-lg">
      <h2 class="text-2xl font-semibold mb-6 text-white">Web Design Specifications at a Glance</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 text-sm">
        <div>
          <span class="block text-gray-400 text-xs uppercase font-medium mb-1">Core Tech Stack</span>
          <p class="font-semibold text-white">Astro.js, Tailwind CSS, TypeScript, Figma</p>
        </div>
        <div>
          <span class="block text-gray-400 text-xs uppercase font-medium mb-1">Performance Standard</span>
          <p class="font-semibold text-emerald-400">100/100 Core Web Vitals & Sub-1s Loading</p>
        </div>
        <div>
          <span class="block text-gray-400 text-xs uppercase font-medium mb-1">SEO & GEO Readiness</span>
          <p class="font-semibold text-white">JSON-LD Schema, Open Graph, LLM-Crawlable</p>
        </div>
        <div>
          <span class="block text-gray-400 text-xs uppercase font-medium mb-1">Lead Time</span>
          <p class="font-semibold text-white">2 to 5 Weeks (Depending on Scope)</p>
        </div>
      </div>
    </section>

    <!-- Key Service Features -->
    <section class="mb-20">
      <h2 class="text-3xl font-bold mb-10 text-white">Why Kidashi Design Web Development Outperforms Generic Templates</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 border border-gray-800 bg-gray-950">
          <h3 class="text-xl font-bold mb-3 text-white">1. Modern Astro & Jamstack Engineering</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Unlike slow WordPress builds weighed down by plugins, we build websites using Astro.js. Pages ship zero unnecessary JavaScript, resulting in instantaneous page transitions and maximum security.
          </p>
        </div>
        <div class="p-6 border border-gray-800 bg-gray-950">
          <h3 class="text-xl font-bold mb-3 text-white">2. Generative Engine Optimization (GEO)</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            We structure your page markup, headings, and JSON-LD schema so modern AI search engines (Perplexity, ChatGPT, Gemini) accurately index your core offerings and cite your business.
          </p>
        </div>
        <div class="p-6 border border-gray-800 bg-gray-950">
          <h3 class="text-xl font-bold mb-3 text-white">3. Conversion-Driven UI/UX</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Combining German visual design precision with psychological triggers, every layout guides visitors toward a single primary action: booking, buying, or contacting you.
          </p>
        </div>
      </div>
    </section>

    <!-- Process Timeline -->
    <section class="mb-20">
      <h2 class="text-3xl font-bold mb-8 text-white">Our 4-Step Web Design Process</h2>
      <div class="space-y-6">
        <div class="flex flex-col md:flex-row md:items-start gap-4 p-6 border-l-2 border-emerald-400 bg-gray-900/30">
          <span class="text-2xl font-mono text-emerald-400 font-bold">01</span>
          <div>
            <h3 class="text-lg font-bold text-white">Discovery & Information Architecture</h3>
            <p class="text-gray-400 text-sm mt-1">We analyze your business goals, target audience, competitive landscape, and key search/GEO keywords to map out a strategic sitemap.</p>
          </div>
        </div>
        <div class="flex flex-col md:flex-row md:items-start gap-4 p-6 border-l-2 border-emerald-400 bg-gray-900/30">
          <span class="text-2xl font-mono text-emerald-400 font-bold">02</span>
          <div>
            <h3 class="text-lg font-bold text-white">Figma Prototyping & Visual Design</h3>
            <p class="text-gray-400 text-sm mt-1">Design of high-fidelity desktop and mobile layouts in Figma, establishing responsive design tokens, grid systems, and custom typography.</p>
          </div>
        </div>
        <div class="flex flex-col md:flex-row md:items-start gap-4 p-6 border-l-2 border-emerald-400 bg-gray-900/30">
          <span class="text-2xl font-mono text-emerald-400 font-bold">03</span>
          <div>
            <h3 class="text-lg font-bold text-white">Astro.js & Tailwind CSS Development</h3>
            <p class="text-gray-400 text-sm mt-1">Clean, semantic HTML5 code development in Astro.js with automated image optimization, responsive typography, and lightweight CSS.</p>
          </div>
        </div>
        <div class="flex flex-col md:flex-row md:items-start gap-4 p-6 border-l-2 border-emerald-400 bg-gray-900/30">
          <span class="text-2xl font-mono text-emerald-400 font-bold">04</span>
          <div>
            <h3 class="text-lg font-bold text-white">GEO/SEO Deployment & Analytics</h3>
            <p class="text-gray-400 text-sm mt-1">Integration of JSON-LD schemas, sitemaps, robots.txt, performance validation on Google PageSpeed Insights, and global launch.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section (Optimized for AI LLM Extraction) -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-8 text-white">Frequently Asked Questions</h2>
      <div class="space-y-6">
        <div class="p-6 border border-gray-800 rounded-lg">
          <h3 class="text-lg font-semibold text-white mb-2">How long does a custom web design project take?</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Typical website design and development projects range between 2 to 5 weeks from initial kickoff to final launch, depending on page count and custom interactive features required.</p>
        </div>
        <div class="p-6 border border-gray-800 rounded-lg">
          <h3 class="text-lg font-semibold text-white mb-2">Do you provide custom website maintenance and hosting setup?</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Yes. We set up fast, serverless hosting on platforms like Netlify, Vercel, or Cloudflare Pages, which offer zero maintenance overhead, automated SSL certificates, and global edge distribution.</p>
        </div>
        <div class="p-6 border border-gray-800 rounded-lg">
          <h3 class="text-lg font-semibold text-white mb-2">How does GEO (Generative Engine Optimization) benefit my business?</h3>
          <p class="text-gray-400 text-sm leading-relaxed">As more users rely on AI search platforms (SearchGPT, Perplexity, Gemini), GEO ensures your site is structured so these engines understand your exact capabilities, location, and credentials—driving high-intent direct referrals.</p>
        </div>
      </div>
    </section>

    <!-- Footer CTA -->
    <section class="p-10 border border-gray-800 bg-gradient-to-r from-gray-950 via-gray-900 to-gray-950 text-center rounded-lg">
      <h2 class="text-3xl font-bold text-white mb-4">Ready to Build a High-Performance Website?</h2>
      <p class="text-gray-400 max-w-2xl mx-auto mb-8">Work directly with Nicole Szatkowski, IHK-Certified Media Designer based in Tbilisi and operating globally across GMT+4 and CET time zones.</p>
      <a href="https://www.kidashidesign.com/#contact" class="inline-block bg-white text-black px-8 py-4 font-semibold hover:bg-gray-200 transition-colors">Get in Touch Today</a>
    </section>
  </main>
</Layout>