---
import Layout from '../../../layouts/Layout.astro';

const pageTitle = 'Custom Web Design & Astro Development | Kidashi Design';
const pageDescription =
  'Custom, mobile-first websites designed in Figma and developed with Astro and Tailwind CSS. Fast, accessible, SEO-ready web experiences by Kidashi Design.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://www.kidashidesign.com/services/web-design#service',
      name: 'Custom Web Design & Astro Development',
      provider: {
        '@type': 'ProfessionalService',
        name: 'Kidashi Design',
        url: 'https://www.kidashidesign.com/',
        founder: {
          '@type': 'Person',
          name: 'Nicole Szatkowski'
        },
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Tbilisi',
          addressCountry: 'GE'
        }
      },
      description:
        'Custom web design, UI/UX prototyping, responsive frontend development, performance optimization, and structured SEO foundations for businesses worldwide.',
      areaServed: 'Worldwide',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Web Design Deliverables',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Custom UI/UX Design in Figma'
            }
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Astro & Tailwind CSS Development'
            }
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Technical SEO & Structured Data Setup'
            }
          }
        ]
      }
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Why use Astro for a custom website?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Astro allows websites to ship minimal client-side JavaScript by default and supports a component-based development workflow. This can help create fast, lightweight websites while retaining flexibility for interactive features where they are needed.'
          }
        },
        {
          '@type': 'Question',
          name: 'What is included in Kidashi Design\'s web design service?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'A typical project can include information architecture, UI/UX design in Figma, responsive frontend development with Astro and Tailwind CSS, metadata, structured data, accessibility considerations, performance optimization, and pre-launch quality assurance.'
          }
        },
        {
          '@type': 'Question',
          name: 'How long does a custom website project take?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Project timelines depend on scope, content readiness, number of pages, and required functionality. Smaller websites may take a few weeks, while larger or more complex projects require additional planning and development time.'
          }
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage="https://www.kidashidesign.com/images/Nicole-Portrait.webp"
  navVariant="nav--light"
  navActive="services"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Hero Section -->
  <section
    class="about3d"
    style="padding-top: calc(var(--nav-h) + clamp(3rem, 6vw, 6rem));"
  >
    <div class="container">
      <div class="about3d__stage reveal">
        <div class="about3d__card" data-tilt>
          <div class="about3d__content">
            <span class="eyebrow" data-tilt-z="50">
              Service 01 &bull; Digital &amp; Development
            </span>

            <h1 class="about3d__title" data-tilt-z="70">
              High-Performance Websites Designed for People, Search &amp; Growth
            </h1>

            <p class="about3d__text" data-tilt-z="30">
              Custom, mobile-first websites designed around your brand and
              business goals. From <strong>Figma</strong> concepts to
              production-ready <strong>Astro</strong> and
              <strong>Tailwind CSS</strong> development, every experience is
              built to be clear, responsive, lightweight, and scalable.
            </p>

            <div class="about3d__foot">
              <ul class="about3d__points" data-tilt-z="20">
                <li>Custom UI/UX Design &amp; Information Architecture</li>
                <li>Astro &amp; Tailwind CSS Development</li>
                <li>Responsive, Mobile-First Experiences</li>
                <li>SEO, Structured Data &amp; Performance Foundations</li>
              </ul>

              <a
                href="/contact/"
                class="btn btn--outline-dark about3d__btn"
                data-tilt-z="60"
              >
                Start a Web Project
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="about-content">
    <div class="container">
      <div class="about-content__grid">
        <div class="about-content__main">
          <h2 class="reveal">
            Custom Web Design Without the Limitations of Generic Templates
          </h2>

          <p class="reveal" data-delay="100">
            A website should do more than look polished. It should communicate
            your value clearly, guide visitors toward meaningful actions, and
            provide a solid technical foundation for long-term growth.
          </p>

          <h3 class="reveal" style="margin-top: 2rem;">
            1. Strategic Design Before Development
          </h3>

          <p class="reveal" data-delay="100">
            Every project begins with structure. We define your core pages,
            content hierarchy, user journeys, and conversion priorities before
            moving into visual design. The result is a website with a clear
            purpose behind every section.
          </p>

          <h3 class="reveal" style="margin-top: 2rem;">
            2. Modern Astro &amp; Jamstack Development
          </h3>

          <p class="reveal" data-delay="100">
            Websites are developed with modern, component-based technologies
            such as Astro and Tailwind CSS. This approach supports lightweight
            pages, reusable design systems, and interactive functionality only
            where it adds real value.
          </p>

          <h3 class="reveal" style="margin-top: 2rem;">
            3. SEO &amp; AI-Readable Content Foundations
          </h3>

          <p class="reveal" data-delay="100">
            Semantic HTML, descriptive page structure, metadata, internal
            linking, and structured data help search engines better understand
            your website and services. Clear information architecture also
            creates stronger foundations for emerging AI-powered discovery
            systems.
          </p>

          <h3 class="reveal" style="margin-top: 2rem;">
            4. Responsive, Conversion-Focused UI/UX
          </h3>

          <p class="reveal" data-delay="100">
            Every interface is designed for real-world use across desktop,
            tablet, and mobile devices. Typography, spacing, visual hierarchy,
            and calls to action work together to make your content easier to
            understand and navigate.
          </p>

          <h2 class="reveal" style="margin-top: 4rem;">
            Our Web Design Process
          </h2>

          <div class="service-process">
            <article class="reveal" data-delay="50">
              <h3>01. Discovery &amp; Strategy</h3>
              <p>
                We define project goals, audiences, required pages, content
                priorities, and the overall structure of your website.
              </p>
            </article>

            <article class="reveal" data-delay="100">
              <h3>02. UI/UX Design in Figma</h3>
              <p>
                High-fidelity layouts are created for key screen sizes, with
                typography, spacing, components, and visual direction aligned
                with your brand.
              </p>
            </article>

            <article class="reveal" data-delay="150">
              <h3>03. Frontend Development</h3>
              <p>
                Approved designs are translated into responsive, semantic
                frontend code using Astro, Tailwind CSS, and additional
                technologies where the project requires them.
              </p>
            </article>

            <article class="reveal" data-delay="200">
              <h3>04. QA &amp; Launch</h3>
              <p>
                Before launch, the website is reviewed across devices and
                browsers, with metadata, structured data, performance, links,
                and key interactions checked before deployment.
              </p>
            </article>
          </div>

          <h2 class="reveal" style="margin-top: 4rem;">
            Frequently Asked Questions
          </h2>

          <div class="service-faq reveal" data-delay="100">
            <details>
              <summary>
                Why build a custom website instead of using a pre-made template?
              </summary>
              <p>
                A custom website gives you more control over your brand,
                content structure, user experience, and technical setup.
                Instead of adapting your business to a generic template, the
                website is designed around your actual goals and requirements.
              </p>
            </details>

            <details>
              <summary>How long does a website project take?</summary>
              <p>
                Timelines vary depending on scope, page count, content
                readiness, revisions, and custom functionality. After an
                initial consultation, you will receive a clearer project
                timeline based on your specific requirements.
              </p>
            </details>

            <details>
              <summary>Can you help with hosting and deployment?</summary>
              <p>
                Yes. Hosting and deployment can be configured as part of the
                project, with suitable platforms selected based on the
                website's technical requirements and maintenance needs.
              </p>
            </details>

            <details>
              <summary>Can my website be optimized for search engines?</summary>
              <p>
                Yes. SEO foundations can include semantic page structure,
                titles and descriptions, Open Graph metadata, XML sitemaps,
                robots directives, internal linking, and relevant JSON-LD
                structured data.
              </p>
            </details>
          </div>
        </div>

        <!-- Sidebar -->
        <aside>
          <div class="sidebar-block reveal" data-glow="blue">
            <span class="sidebar-block__label">Design &amp; Development</span>
            <ul>
              <li>UI/UX &amp; Figma</li>
              <li>Astro</li>
              <li>Tailwind CSS</li>
              <li>TypeScript</li>
            </ul>
          </div>

          <div
            class="sidebar-block reveal"
            data-delay="100"
            data-glow="orange"
          >
            <span class="sidebar-block__label">Web Foundations</span>
            <ul>
              <li>Responsive Design</li>
              <li>Semantic HTML</li>
              <li>Performance Optimization</li>
              <li>Accessibility Considerations</li>
            </ul>
          </div>

          <div
            class="sidebar-block reveal"
            data-delay="200"
            data-glow="blue"
          >
            <span class="sidebar-block__label">SEO &amp; Discovery</span>
            <ul>
              <li>JSON-LD Structured Data</li>
              <li>Open Graph Metadata</li>
              <li>XML Sitemaps</li>
              <li>Clear Content Architecture</li>
            </ul>
          </div>

          <div
            class="sidebar-block reveal"
            data-delay="300"
            data-glow="orange"
          >
            <span class="sidebar-block__label">Project Delivery</span>
            <ul>
              <li>Custom Project Scope</li>
              <li>Direct Collaboration</li>
              <li>Testing &amp; QA</li>
              <li>Launch Support</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="about-values">
    <div class="container">
      <h2 class="reveal">
        Ready to Build a Website That Feels Like Your Brand?
      </h2>

      <p class="reveal" data-delay="100">
        Work directly with Nicole Szatkowski and turn your website into a
        clearer, faster, and more purposeful digital experience for your
        audience.
      </p>

      <div class="about-values__cta reveal" data-delay="200">
        <a href="/contact/" class="btn btn--primary">
          Discuss Your Web Project
        </a>
      </div>
    </div>
  </section>
</Layout>