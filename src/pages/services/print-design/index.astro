---
import Layout from '../../../layouts/Layout.astro';

const pageTitle = 'Print Design — Kidashi Design';
const pageDescription =
  'Professional print design for business cards, brochures, flyers, editorial layouts, packaging, and marketing materials. Production-ready artwork by Nicole Szatkowski.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://www.kidashidesign.com/services/print-design/#service',
      name: 'Print Design',
      provider: {
        '@type': 'ProfessionalService',
        name: 'Kidashi Design',
        url: 'https://www.kidashidesign.com/',
        founder: {
          '@type': 'Person',
          name: 'Nicole Szatkowski'
        }
      },
      description:
        'Professional print design for business cards, stationery, brochures, editorial layouts, packaging, event materials, signage, and other physical brand touchpoints.',
      areaServed: 'Worldwide'
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Are Kidashi Design print files ready for commercial printing?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Print artwork is prepared according to the technical requirements of the selected printer and production method. Depending on the project, this can include the correct document size, bleed, color mode, resolution, crop marks, and other production specifications.'
          }
        },
        {
          '@type': 'Question',
          name: 'Why is professional prepress knowledge important for print design?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Professional prepress knowledge helps ensure that artwork is prepared correctly for physical production. This includes considering document dimensions, bleed, color settings, resolution, typography, finishing, and the technical requirements of the printing process.'
          }
        },
        {
          '@type': 'Question',
          name: 'Can Kidashi Design work directly with my printing company?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. When needed, Kidashi Design can coordinate with your printing company to review technical specifications and prepare artwork according to the printer\'s production requirements.'
          }
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage="https://www.kidashidesign.com/images/Nicole-Portrait.webp"
  navVariant="nav--light"
  navActive="services"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Hero Section -->
  <section
    class="about3d service-hero"
    style="padding-top: calc(var(--nav-h) + clamp(3rem, 6vw, 6rem));"
  >
    <div class="container">
      <div class="about3d__stage reveal">
        <div class="about3d__card" data-tilt>
          <div class="about3d__media service-hero__media" data-tilt-z="40">
            <img
              class="about3d__img"
              src="/images/Nicole-Portrait.webp"
              alt="Nicole Szatkowski, founder and designer at Kidashi Design"
              decoding="async"
              loading="eager"
            />
          </div>

          <div class="about3d__content">
            <span class="eyebrow" data-tilt-z="50">
              Service 03 · Print Design
            </span>

            <h1 class="about3d__title" data-tilt-z="70">
              Print Design Made to Work Beyond the Screen.
            </h1>

            <p class="about3d__text" data-tilt-z="30">
              From business cards and brochures to packaging, editorial layouts, and large-format materials, I design physical touchpoints that carry your brand into the real world. Every project balances visual impact with the practical requirements of professional print production.
            </p>

            <div class="about3d__foot">
              <ul class="about3d__points" data-tilt-z="20">
                <li>Business cards &amp; corporate stationery</li>
                <li>Brochures, catalogues &amp; editorial design</li>
                <li>Packaging, labels &amp; promotional materials</li>
                <li>Production-ready artwork for print</li>
              </ul>

              <a
                href="/contact/"
                class="btn btn--outline-dark about3d__btn"
                data-tilt-z="60"
              >
                Let's Discuss Your Print Project
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Floating Visual Scene -->
  <div class="about-hero-float service-float" id="printDesignFloat">
    <div class="container">
      <div class="about-hero-float__grid about-hero-float__grid--scene-only">
        <div class="about-float-scene">
          <div class="about-float-scene__inner" id="printDesignFloatScene">
            <div
              class="about-float-el about-float-el--photo about-float-photo--1"
              data-depth="1"
            >
              <img
                src="/images/about/himalaya-mountains.webp"
                alt="Creative inspiration behind visual design"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div
              class="about-float-el about-float-el--photo about-float-photo--2"
              data-depth="1.8"
            >
              <img
                src="/images/about/himalaya-pointing.webp"
                alt="Exploring creative perspectives and new environments"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div
              class="about-float-el about-float-el--photo about-float-photo--3"
              data-depth="1.3"
            >
              <img
                src="/images/about/jungle-rest.webp"
                alt="Creative process and visual exploration"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div
              class="about-float-el about-float-el--photo about-float-photo--4"
              data-depth="2.2"
            >
              <img
                src="/images/about/prayer-flags-dharamshala.webp"
                alt="International inspiration and visual storytelling"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div
              class="about-float-el about-float-el--photo about-float-photo--5"
              data-depth="1.6"
            >
              <img
                src="/images/about/Nicole-Daramshala.webp"
                alt="Nicole Szatkowski, founder of Kidashi Design"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          <!-- Grain Texture Overlay -->
          <svg
            class="about-float-grain"
            xmlns="http://www.w3.org/2000/svg"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <filter id="printGrain">
              <feTurbulence
                type="fractalNoise"
                baseFrequency="0.82"
                numOctaves="4"
                stitchTiles="stitch"
              />
              <feColorMatrix type="saturate" values="0" />
            </filter>

            <rect width="100%" height="100%" filter="url(#printGrain)" />
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <section class="about-content service-content">
    <div class="container">
      <div class="about-content__grid">
        <div class="about-content__main">
          <h2 class="reveal">Print Design That Feels as Good as It Looks</h2>

          <p class="reveal" data-delay="100">
            <strong>Kidashi Design</strong> creates printed materials that extend your brand beyond digital spaces. Whether someone is picking up a business card, reading a brochure, opening a package, or walking past an event display, every physical touchpoint is an opportunity to leave a lasting impression.
          </p>

          <p class="reveal" data-delay="100">
            Good print design is not only about creating an attractive layout. It also means understanding how the final piece will be produced, handled, folded, finished, and experienced in the real world.
          </p>

          <h2 class="reveal" style="margin-top: 3rem;">
            Designed With Production in Mind
          </h2>

          <p class="reveal" data-delay="100">
            As an IHK-certified Media Designer trained in both digital and print design, I consider the technical side of a project from the beginning. Artwork is prepared with the intended production process in mind rather than treating print requirements as an afterthought.
          </p>

          <p class="reveal" data-delay="100">
            Depending on the project and printer, this can include document dimensions, bleed, safe areas, color profiles, image resolution, typography, finishing requirements, and final file preparation.
          </p>

          <div class="service-deliverables reveal" data-delay="200">
            <div class="service-deliverables__item">
              <h3>Business &amp; Stationery</h3>
              <p>
                Business cards, letterheads, presentation folders, and other branded materials designed to make your everyday communication feel considered and consistent.
              </p>
            </div>

            <div class="service-deliverables__item">
              <h3>Brochures &amp; Editorial</h3>
              <p>
                Brochures, catalogues, magazines, reports, and multi-page publications with clear layouts, strong typographic hierarchy, and easy-to-follow information.
              </p>
            </div>

            <div class="service-deliverables__item">
              <h3>Packaging &amp; Labels</h3>
              <p>
                Packaging and label design that brings together your brand, product information, and the technical requirements of the chosen packaging format.
              </p>
            </div>

            <div class="service-deliverables__item">
              <h3>Large-Format Design</h3>
              <p>
                Banners, signage, displays, event materials, and other large-scale graphics designed for visibility and impact in physical spaces.
              </p>
            </div>
          </div>

          <h2 class="reveal" style="margin-top: 3rem;">
            From Screen to Physical Object
          </h2>

          <p class="reveal" data-delay="100">
            Print introduces things that do not exist in purely digital design: paper texture, scale, folding, binding, finishes, materials, and physical interaction. These details can completely change how a design feels.
          </p>

          <p class="reveal" data-delay="100">
            I take these factors into account throughout the design process, helping create materials that are not only visually strong on screen but also practical and effective once they are produced.
          </p>

          <h2 class="reveal" style="margin-top: 3rem;">
            Prepared for Your Production Partner
          </h2>

          <p class="reveal" data-delay="100">
            Different printers, production methods, and materials can require different technical specifications. Where necessary, I can work from your printer's requirements and prepare the final artwork accordingly.
          </p>

          <p class="reveal" data-delay="100">
            This helps reduce unnecessary back-and-forth before production and gives your printer the information and files they need to move the project forward.
          </p>

          <h2 class="reveal" style="margin-top: 3rem;">
            Print Design FAQs
          </h2>

          <div class="service-faq reveal" data-delay="100">
            <details>
              <summary>
                Are the final files ready for commercial printing?
              </summary>
              <p>
                Yes. Final artwork can be prepared according to the technical requirements of your chosen printer. The exact file setup depends on the printing process and production specifications for your project.
              </p>
            </details>

            <details>
              <summary>
                Why does professional prepress knowledge matter?
              </summary>
              <p>
                Print has technical requirements that can affect the final result. Understanding areas such as bleed, color settings, resolution, typography, document setup, and finishing helps ensure that the design is prepared appropriately for production.
              </p>
            </details>

            <details>
              <summary>
                Can you communicate directly with my printing company?
              </summary>
              <p>
                Yes. If needed, I can coordinate with your printer to review technical specifications and make sure the artwork is prepared for their production process.
              </p>
            </details>

            <details>
              <summary>
                Do I need to have a printer before starting the design?
              </summary>
              <p>
                Not necessarily. We can start with the design direction and intended format first. Once a production partner or printing method is selected, the final artwork can be adapted to the relevant technical requirements.
              </p>
            </details>
          </div>
        </div>

        <!-- Sidebar -->
        <aside>
          <div class="sidebar-block reveal" data-glow="orange">
            <span class="sidebar-block__label">Print Materials</span>
            <ul>
              <li>Business cards &amp; stationery</li>
              <li>Flyers &amp; brochures</li>
              <li>Catalogues &amp; editorial layouts</li>
              <li>Promotional materials</li>
            </ul>
          </div>

          <div
            class="sidebar-block reveal"
            data-delay="100"
            data-glow="blue"
          >
            <span class="sidebar-block__label">Packaging</span>
            <ul>
              <li>Product packaging</li>
              <li>Labels &amp; stickers</li>
              <li>Boxes &amp; physical formats</li>
              <li>Branded product materials</li>
            </ul>
          </div>

          <div
            class="sidebar-block reveal"
            data-delay="200"
            data-glow="orange"
          >
            <span class="sidebar-block__label">Production</span>
            <ul>
              <li>Print-ready artwork</li>
              <li>Bleed &amp; document setup</li>
              <li>Color &amp; resolution checks</li>
              <li>Printer specification support</li>
            </ul>
          </div>

          <div
            class="sidebar-block reveal"
            data-delay="300"
            data-glow="blue"
          >
            <span class="sidebar-block__label">Working Worldwide</span>
            <ul>
              <li>Remote-friendly collaboration</li>
              <li>Digital proofing</li>
              <li>Direct communication</li>
              <li>International print partners</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="about-values service-values">
    <div class="container">
      <h2 class="reveal">
        Your Brand Doesn't Stop at the Screen.
      </h2>

      <p class="reveal" data-delay="100">
        From the first layout to the final production files, you work directly with me. Together, we'll create printed materials that feel consistent with your brand and are prepared for the way they will exist in the real world.
      </p>

      <div class="about-values__cta reveal" data-delay="200">
        <a href="/contact/" class="btn btn--primary">
          Start Your Print Project
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer__bottom">
        <span class="footer__copy">
          &copy; 2026 Kidashi Design &mdash; Nicole Szatkowski
        </span>

        <div class="footer__socials">
          <a
            href="https://www.instagram.com/kidashi.design/"
            class="footer__social-btn"
            aria-label="Instagram"
            target="_blank"
            rel="noopener"
          >
            <svg width="17" height="17" viewBox="0 0 48 48" fill="none">
              <path
                d="M15.6 4H32.4C38.8 4 44 9.2 44 15.6V32.4C44 35.4765 42.7779 38.427 40.6024 40.6024C38.427 42.7779 35.4765 44 32.4 44H15.6C9.2 44 4 38.8 4 32.4V15.6C4 12.5235 5.22214 9.57298 7.39756 7.39756C9.57298 5.22214 12.5235 4 15.6 4Z"
                fill="currentColor"
              />
            </svg>
          </a>

          <a
            href="https://www.linkedin.com/in/nicole-szatkowski"
            class="footer__social-btn"
            aria-label="LinkedIn"
            target="_blank"
            rel="noopener"
          >
            <svg width="17" height="17" viewBox="0 0 48 48" fill="none">
              <path
                d="M13.9989 16.96H5.99891V42H13.9989V16.96ZM26.6389 16.96H18.6789V42H26.5589V28.86C26.5589 21.54 36.0989 20.86 36.0989 28.86V42H43.9989V26.14C43.9989 13.8 29.8789 14.26 26.5589 20.32L26.6389 16.96Z"
                fill="currentColor"
              />
            </svg>
          </a>

          <a
            href="https://dribbble.com/fotofreakkkk"
            class="footer__social-btn"
            aria-label="Dribbble"
            target="_blank"
            rel="noopener"
          >
            <svg width="17" height="17" viewBox="0 0 48 48" fill="none">
              <path
                d="M23.9993 4.00001C28.7753 4.00001 33.1613 5.67401 36.5993 8.46801C33.6236 11.5919 30.0805 14.1209 26.1593 15.92C23.9521 11.9671 21.3667 8.23762 18.4393 4.78401C20.2465 4.26252 22.1183 3.99858 23.9993 4.00001Z"
                fill="currentColor"
              />
            </svg>
          </a>

          <a
            href="https://www.behance.net/nicoleszatkow1"
            class="footer__social-btn"
            aria-label="Behance"
            target="_blank"
            rel="noopener"
          >
            <svg width="17" height="17" viewBox="0 0 48 48" fill="none">
              <path
                d="M4 36.5802V11.4202H16.2C17.3133 11.4199 18.4221 11.561 19.5 11.8396C20.5208 12.1058 21.4883 12.5458 22.36 13.1402C23.2051 13.723 23.8924 14.5064 24.36 15.4202C24.8806 16.4402 25.1352 17.576 25.1 18.7202V36.5802H4Z"
                fill="currentColor"
              />
            </svg>
          </a>
        </div>

        <nav class="footer__legal">
          <a href="/impressum/">Imprint</a>
          <a href="/datenschutz/">Privacy Policy</a>
        </nav>
      </div>
    </div>
  </footer>
</Layout>